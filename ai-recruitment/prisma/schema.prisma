// =============================================================================
// SmartHire AI — Prisma Schema (Phase 1 parallel domain model)
// =============================================================================
//
// TARGET  — Spec-aligned models (Groups 1–7); use for new features.
// LEGACY  — Pre-Phase-1 models; kept until Phase 2+ cutover (do not extend).
// BRIDGE  — Nullable FKs linking legacy ↔ target (legacyResumeVersionId, etc.).
//
// DATABASE_URL and DIRECT_DATABASE_URL live in prisma.config.ts (Prisma 7).
//
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── TARGET enums (spec-aligned; legacy enums kept below) ─────────────────────

enum UserRole {
  CANDIDATE
  RECRUITER
  HIRING_MANAGER
  ADMIN
}

enum IndustryProfile {
  TECH
  FINANCE
  HEALTHCARE
  SALES
  CREATIVE
  LEGAL
  GENERAL
}

enum SeniorityBand {
  L1_INTERN
  L2_JUNIOR
  L3_MID
  L4_SENIOR
  L5_STAFF
  L6_PRINCIPAL
}

enum ParseStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REQUIRES_REVIEW
}

enum JobStatusV2 {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
  ARCHIVED
}

enum ApplicationStatusV2 {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum RecruiterOutcome {
  HIRED
  REJECTED
  INTERVIEW_STAGE1
  INTERVIEW_STAGE2
  OFFER_EXTENDED
  OFFER_DECLINED
  WITHDRAWN
}

// ─── TARGET Group 1: Identity ─────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                  User[]
  candidates             Candidate[]
  recruiters             Recruiter[]
  companies              Company[]
  resumes                Resume[]
  resumeVersionsV2       ResumeVersionV2[]
  parsedResumes          ParsedResume[]
  resumeSearchEmbeddings ResumeSearchEmbedding[]
  jobs                   Job[]
  applications           Application[]
  applicationAtsScores   ApplicationAtsScore[]
  atsSkillGaps           AtsSkillGap[]
  careerReadinessRows    CareerReadiness[]
  mockInterviewSessionsV2 MockInterviewSessionV2[]
  recruiterOutcomeSignals RecruiterOutcomeSignal[]
  weightCalibrations     WeightCalibration[]
  extractionPromptVariants ExtractionPromptVariant[]
  extractionPromptAssignments ExtractionPromptAssignment[]
  extractionEvents       ExtractionEvent[]
  dailyMetrics           DailyMetric[]
  embeddingDriftRuns     EmbeddingDriftRun[]
  notifications          Notification[]
  auditLogs              AuditLog[]

  @@index([createdAt])
}

// ─── LEGACY + extended identity ───────────────────────────────────────────────

model User {
  id               String                 @id @default(cuid())
  clerkId          String?                @unique
  name             String?
  email            String                 @unique
  candidate        Candidate?
  recruiter        Recruiter?
  emailVerified    DateTime?
  password         String?
  image            String?
  role             Role                   @default(CANDIDATE)
  company          Company?               @relation(fields: [companyId], references: [id])
  companyId        String?
  jobs             Job[]
  accounts         Account[]
  sessions         Session[]
  savedJobsList    SavedJob[]
  jobAlertRules    JobAlert[]
  headline         String?
  phone            String?
  location         String?
  school           String?
  graduationYear   String?
  linkedInUrl      String?
  githubUrl        String?
  websiteUrl       String?
  jobAlerts        Boolean                @default(true)
  aiSuggestions    Boolean                @default(false)
  publicProfile    Boolean                @default(true)
  reputationScore  Int                    @default(0)
  technicalScore   Int                    @default(0)
  softScore        Int                    @default(0)
  resumeVersions   ResumeVersion[]
  mockSessions     MockInterviewSession[]
  careerMilestones CareerMilestone[]
  skillGoals       SkillGoal[]
  notifications    Notification[]
  behaviorSignals  UserBehaviorSignal[]
  salaryProfile    UserSalaryProfile?
  tenantId         String?
  tenant           Tenant?                @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  isActive         Boolean                @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([tenantId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id              String           @id @default(cuid())
  name            String
  logo            String?
  logoUrl         String?
  industry        String?
  industryProfile IndustryProfile?
  size            String?
  averageSalaryL  Int?
  employeeRating  Float?
  tenantId        String?
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  users           User[]
  jobs            Job[]
  website         String?
  description     String?          @db.Text
  location        String?
  foundedYear     Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([name])
  @@index([industry])
  @@index([tenantId, createdAt])
}

// Recruiter profile extending User (users with role = RECRUITER)
model Recruiter {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  title      String?
  department String?
  bio        String?  @db.Text
  avatarUrl  String?
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  isActive   Boolean  @default(true)
  jobs       Job[]
  recruiterOutcomeSignals RecruiterOutcomeSignal[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([tenantId, createdAt])
}

model Job {
  id                 String              @id @default(cuid())
  title              String
  description        String              @db.Text
  requirements       String              @db.Text
  location           String
  type               JobType
  status             JobStatus           @default(ACTIVE)
  salary             String?
  salaryMin          Int?
  salaryMax          Int?
  experienceLevel    String?
  experienceMin      Int?
  experienceMax      Int?
  workMode           WorkMode?
  requiredSkills     String[]            @default([])
  postedBy           User                @relation(fields: [userId], references: [id])
  userId             String
  recruiter          Recruiter?          @relation(fields: [recruiterId], references: [id])
  recruiterId        String?
  company            Company             @relation(fields: [companyId], references: [id])
  companyId          String
  applications       Application[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  alerts             JobAlert[]
  savedBy            SavedJob[]
  jobRecommendations JobRecommendation[]
  behaviorEvents     BehaviorEvent[]
  jobSkills          JobSkill[]
  embeddings         JobEmbedding[]
  recommendationScores JobRecommendationScore[]
  salaryData          JobSalaryData?
  tenantId            String?
  tenant              Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  industryProfile     IndustryProfile?
  seniorityBand       SeniorityBand?
  isRemote            Boolean?
  expiresAt           DateTime?
  statusV2            JobStatusV2?
  mockInterviewSessionsV2 MockInterviewSessionV2[]
  applicationAtsScores    ApplicationAtsScore[]
  recruiterOutcomeSignals RecruiterOutcomeSignal[]

  @@index([title])
  @@index([location])
  @@index([experienceLevel])
  @@index([experienceMin, experienceMax])
  @@index([createdAt])
  @@index([workMode])
  @@index([type])
  @@index([status, createdAt])
  @@index([companyId])
  @@index([salaryMin])
  @@index([salaryMax])
  @@index([requiredSkills], type: Gin)
  @@index([recruiterId])
  @@index([tenantId, createdAt])
}

model Candidate {
  id                  String            @id @default(cuid())
  userId              String?           @unique
  user                User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  email               String            @unique
  phone               String?
  headline            String?
  location            String?
  city                String?
  country             String?
  photoUrl            String?
  avatarUrl           String?   // uploaded profile picture (CDN URL)
  summary             String?           @db.Text
  profileCompleteness Int               @default(0)
  resumeUrl           String?
  skills              String[]          @default([])
  experience          Int?
  aiScore             Float?
  aiSummary           String?           @db.Text
  // Advanced fields
  availability        String?           // IMMEDIATE, 2_WEEKS, 1_MONTH, 3_MONTHS
  workAuthorization   String?           // CITIZEN, PERMANENT_RESIDENT, VISA, OPT
  openToFreelance     Boolean           @default(false)
  internshipInterest  Boolean           @default(false)
  languagesSpoken     String[]          @default([])
  applications        Application[]
  profile             CandidateProfile?
  educations          Education[]
  skillRecords        Skill[]
  experiences         Experience[]
  projects            Project[]
  certifications      Certification[]
  privacy             ProfilePrivacy?
  reputation          ReputationMetrics?
  profileVersions     ProfileVersion[]
  connectedAccounts   ConnectedAccount[]
  behaviorEvents      BehaviorEvent[]
  candidateSkills     CandidateSkill[]
  candidateEmbeddingsLegacy CandidateEmbeddingLegacy[]
  analytics              CandidateAnalytics?
  jobRecommendationScores JobRecommendationScore[]
  preferredRoles         PreferredRole[]
  jobAtsScores           JobAtsScore[]
  listingSkillGaps       JobListingSkillGap[]
  interviewSessions      InterviewSession[]
  tenantId               String?
  tenant                 Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  preferredTitle         String?
  salaryExpectation      Int?
  portfolioUrl           String?
  linkedinUrl            String?
  reputationScoreTarget  Float?
  isActive               Boolean           @default(true)
  resumes                Resume[]
  mockInterviewSessionsV2 MockInterviewSessionV2[]
  recruiterOutcomeSignals RecruiterOutcomeSignal[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([email])
  @@index([userId])
  @@index([skills], type: Gin)
  @@index([profileCompleteness])
  @@index([tenantId, createdAt])
}

model Experience {
  id             String    @id @default(cuid())
  candidateId    String
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  company        String
  jobTitle       String
  employmentType String?   // FULL_TIME, PART_TIME, CONTRACT, FREELANCE, INTERNSHIP
  location       String?
  startDate      DateTime
  endDate        DateTime?
  isCurrent      Boolean   @default(false)
  description    String?   @db.Text
  achievements   String[]  @default([])
  technologies   String[]  @default([])
  order          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([candidateId])
}

model Project {
  id           String    @id @default(cuid())
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  title        String
  description  String?   @db.Text
  technologies String[]  @default([])
  repoUrl      String?
  demoUrl      String?
  teamRole     String?
  startDate    DateTime?
  endDate      DateTime?
  isCurrent    Boolean   @default(false)
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([candidateId])
}

model Certification {
  id           String    @id @default(cuid())
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name         String
  issuer       String
  issueDate    DateTime?
  expiryDate   DateTime?
  credentialId String?
  credentialUrl String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([candidateId])
}

model ProfilePrivacy {
  id              String    @id @default(cuid())
  candidateId     String    @unique
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  isPublic        Boolean   @default(true)
  visibleToRecruiters Boolean @default(true)
  anonymousMode   Boolean   @default(false)
  hideContactInfo Boolean   @default(false)
  updatedAt       DateTime  @updatedAt
}

model ProfileVersion {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    Json      // Full profile JSON snapshot
  createdAt   DateTime  @default(now())

  @@index([candidateId])
}

model ReputationMetrics {
  id                     String    @id @default(cuid())
  candidateId            String    @unique
  candidate              Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewPerformance   Float     @default(0)
  recruiterFeedback      Float     @default(0)
  assessmentCompletionRate Float   @default(0)
  responseRate           Float     @default(0)
  overallScore           Float     @default(0)
  updatedAt              DateTime  @updatedAt
}

model Application {
  id                    String                     @id @default(cuid())
  job                   Job                        @relation(fields: [jobId], references: [id])
  jobId                 String
  candidate             Candidate                  @relation(fields: [candidateId], references: [id])
  candidateId           String
  status                ApplicationStatus          @default(APPLIED)
  aiScore               Float?
  aiNotes               String?                    @db.Text
  interviewProbability  Float?                     @default(0)
  applicationHealthScore Float?                    @default(0)
  readinessScore        Float?                     @default(0)
  tenantId              String?
  tenant                Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  resumeVersionId       String?
  resumeVersion         ResumeVersion?             @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  resumeVersionV2Id     String?
  resumeVersionV2       ResumeVersionV2?           @relation(fields: [resumeVersionV2Id], references: [id], onDelete: SetNull)
  appliedAt             DateTime?
  applicationAtsScore   ApplicationAtsScore?
  interview             Interview?
  statusHistory         ApplicationStatusHistory[]
  recruiterActivities   RecruiterActivity[]
  assessments           Assessment[]
  notes                 ApplicationNote[]
  offer                 Offer?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@unique([jobId, candidateId])
  @@index([candidateId])
  @@index([jobId])
  @@index([status])
  @@index([createdAt])
  @@index([candidateId, status])
  @@index([candidateId, createdAt])
  @@index([tenantId, createdAt])
}

model ApplicationStatusHistory {
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        ApplicationStatus
  updatedBy     String?
  metadata      Json?
  createdAt     DateTime          @default(now())

  @@index([applicationId])
  @@index([applicationId, createdAt])
}

model RecruiterActivity {
  id            String                @id @default(cuid())
  applicationId String
  application   Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  activityType  RecruiterActivityType
  metadata      Json?
  createdAt     DateTime              @default(now())

  @@index([applicationId])
  @@index([applicationId, createdAt])
  @@index([activityType])
  @@index([createdAt])
}

model Assessment {
  id            String           @id @default(cuid())
  applicationId String
  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title         String
  type          String
  score         Float?
  maxScore      Float?
  deadline      DateTime?
  status        AssessmentStatus @default(PENDING)
  completedAt   DateTime?
  metadata      Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([applicationId])
  @@index([deadline])
  @@index([status])
}

model ApplicationNote {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  content       String      @db.Text
  authorId      String
  authorRole    String      @default("CANDIDATE")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId])
  @@index([applicationId, createdAt])
}

model Offer {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  salary        Int?
  currency      String?     @default("USD")
  benefits      String[]    @default([])
  startDate     DateTime?
  expiresAt     DateTime?
  status        OfferStatus @default(PENDING)
  metadata      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId])
}

model CandidateAnalytics {
  id                String    @id @default(cuid())
  candidateId       String    @unique
  candidate         Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applicationsSent  Int       @default(0)
  resumeViewed      Int       @default(0)
  shortlistedCount  Int       @default(0)
  interviewCount    Int       @default(0)
  offerCount        Int       @default(0)
  hiredCount        Int       @default(0)
  rejectedCount     Int       @default(0)
  withdrawnCount    Int       @default(0)
  avgHealthScore    Float     @default(0)
  avgResponseTime   Float?
  lastUpdatedAt     DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([candidateId])
}

model SavedJob {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([userId, jobId])
  @@index([userId, createdAt])
  @@index([jobId])
}

model JobAlert {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  location  String?
  createdAt DateTime  @default(now())
  jobId     String?
  job       Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([role])
  @@index([location])
}

model Education {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  school      String
  degree      String
  field       String
  startYear   String
  endYear     String?
  isCurrent   Boolean   @default(false)
  cgpa        String?
  description String?   @db.Text
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([candidateId])
}

model Skill {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name        String
  level       SkillLevel @default(INTERMEDIATE)
  category    String?    // e.g., "Frontend", "Backend", "DevOps", "Soft Skills"
  isSoftSkill Boolean    @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([candidateId])
}

model CandidateSkill {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name        String
  normalized  String
  level       Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([candidateId])
  @@index([normalized])
  @@unique([candidateId, normalized])
}

model JobSkill {
  id         String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name        String
  normalized  String
  importance  Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([jobId])
  @@index([normalized])
  @@unique([jobId, normalized])
}

enum BehaviorEventType {
  JOB_VIEW
  JOB_CLICK
  JOB_APPLICATION
  JOB_SAVE
  JOB_IGNORE
}

model BehaviorEvent {
  id         String            @id @default(cuid())
  candidateId String
  candidate  Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId      String?
  job        Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  eventType  BehaviorEventType
  metadata   Json?
  createdAt  DateTime          @default(now())

  @@index([candidateId, createdAt])
  @@index([candidateId, eventType])
  @@index([jobId, createdAt])
}

/// LEGACY: pgvector-style float[] cache on Candidate (not Azure AI Search).
model CandidateEmbeddingLegacy {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  source      String    @default("RESUME")
  dimensions  Int
  embedding   Float[]
  checksum    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([candidateId, createdAt])
  @@map("ResumeEmbedding")
}

model JobEmbedding {
  id         String   @id @default(cuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  source     String   @default("JOB_DESCRIPTION")
  dimensions Int
  embedding  Float[]
  checksum   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([jobId, source])
  @@index([jobId, createdAt])
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum AccountProvider {
  GITHUB
  LINKEDIN
  GOOGLE
  HUBSPOT
  SLACK
  ZOOM
  PORTFOLIO
  WEBSITE
  TWITTER
  KAGGLE
  LEETCODE
}

model ConnectedAccount {
  id             String          @id @default(cuid())
  candidateId    String
  candidate      Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  provider       AccountProvider
  username       String?         // display username / handle
  profileUrl     String          // validated external URL
  isOAuth        Boolean         @default(false)
  accessToken    String?         // encrypted at the application layer
  refreshToken   String?         // encrypted at the application layer
  tokenExpiresAt DateTime?       // when the access token expires
  scopes         String[]        @default([]) // granted OAuth scopes
  metadata       Json?           // provider-specific extra data
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([candidateId, provider])
  @@index([candidateId])
}

model Interview {
  id            String          @id @default(cuid())
  application   Application     @relation(fields: [applicationId], references: [id])
  applicationId String          @unique
  scheduledAt   DateTime
  duration      Int?            // duration in minutes
  meetingUrl    String?
  notes         String?         @db.Text
  type          InterviewType
  aiTranscript  String?         @db.Text
  aiFeedback    String?         @db.Text
  status        InterviewStatus @default(SCHEDULED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([scheduledAt])
  @@index([status])
}

enum Role {
  ADMIN
  RECRUITER
  HIRING_MANAGER
  CANDIDATE
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  REMOTE
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum JobStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  RESUME_VIEWED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  OFFER
  REJECTED
  HIRED
  WITHDRAWN
}

enum RecruiterActivityType {
  RESUME_VIEWED
  PROFILE_VIEWED
