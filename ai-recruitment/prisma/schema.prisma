// SmartHire AI Recruitment - Prisma Schema

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String                 @id @default(cuid())
  clerkId          String?                @unique
  name             String?
  email            String                 @unique
  candidate        Candidate?
  recruiter        Recruiter?
  emailVerified    DateTime?
  password         String?
  image            String?
  role             Role                   @default(CANDIDATE)
  company          Company?               @relation(fields: [companyId], references: [id])
  companyId        String?
  jobs             Job[]
  accounts         Account[]
  sessions         Session[]
  savedJobsList    SavedJob[]
  jobAlertRules    JobAlert[]
  headline         String?
  phone            String?
  location         String?
  school           String?
  graduationYear   String?
  linkedInUrl      String?
  githubUrl        String?
  websiteUrl       String?
  jobAlerts        Boolean                @default(true)
  aiSuggestions    Boolean                @default(false)
  publicProfile    Boolean                @default(true)
  reputationScore  Int                    @default(0)
  technicalScore   Int                    @default(0)
  softScore        Int                    @default(0)
  resumeVersions   ResumeVersion[]
  mockSessions     MockInterviewSession[]
  careerMilestones CareerMilestone[]
  skillGoals       SkillGoal[]
  notifications    Notification[]
  behaviorSignals  UserBehaviorSignal[]
  salaryProfile    UserSalaryProfile?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id             String  @id @default(cuid())
  name           String
  logo           String?
  industry       String?
  size           String?
  averageSalaryL Int?
  employeeRating Float?
  users          User[]
  jobs           Job[]
  website        String?
  description    String?  @db.Text
  location       String?
  foundedYear    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
  @@index([industry])
}

// Recruiter profile extending User (users with role = RECRUITER)
model Recruiter {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  title      String?
  department String?
  bio        String?  @db.Text
  avatarUrl  String?
  jobs       Job[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Job {
  id                 String              @id @default(cuid())
  title              String
  description        String              @db.Text
  requirements       String              @db.Text
  location           String
  type               JobType
  status             JobStatus           @default(ACTIVE)
  salary             String?
  salaryMin          Int?
  salaryMax          Int?
  experienceLevel    String?
  experienceMin      Int?
  experienceMax      Int?
  workMode           WorkMode?
  requiredSkills     String[]            @default([])
  postedBy           User                @relation(fields: [userId], references: [id])
  userId             String
  recruiter          Recruiter?          @relation(fields: [recruiterId], references: [id])
  recruiterId        String?
  company            Company             @relation(fields: [companyId], references: [id])
  companyId          String
  applications       Application[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  alerts             JobAlert[]
  savedBy            SavedJob[]
  jobRecommendations JobRecommendation[]
  behaviorEvents     BehaviorEvent[]
  jobSkills          JobSkill[]
  embeddings         JobEmbedding[]
  recommendationScores JobRecommendationScore[]
  salaryData          JobSalaryData?

  @@index([title])
  @@index([location])
  @@index([experienceLevel])
  @@index([experienceMin, experienceMax])
  @@index([createdAt])
  @@index([workMode])
  @@index([type])
  @@index([status, createdAt])
  @@index([companyId])
  @@index([salaryMin])
  @@index([salaryMax])
  @@index([requiredSkills], type: Gin)
  @@index([recruiterId])
}

model Candidate {
  id                  String            @id @default(cuid())
  userId              String?           @unique
  user                User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  email               String            @unique
  phone               String?
  headline            String?
  location            String?
  city                String?
  country             String?
  photoUrl            String?
  avatarUrl           String?   // uploaded profile picture (CDN URL)
  summary             String?           @db.Text
  profileCompleteness Int               @default(0)
  resumeUrl           String?
  skills              String[]          @default([])
  experience          Int?
  aiScore             Float?
  aiSummary           String?           @db.Text
  // Advanced fields
  availability        String?           // IMMEDIATE, 2_WEEKS, 1_MONTH, 3_MONTHS
  workAuthorization   String?           // CITIZEN, PERMANENT_RESIDENT, VISA, OPT
  openToFreelance     Boolean           @default(false)
  internshipInterest  Boolean           @default(false)
  languagesSpoken     String[]          @default([])
  applications        Application[]
  profile             CandidateProfile?
  educations          Education[]
  skillRecords        Skill[]
  experiences         Experience[]
  projects            Project[]
  certifications      Certification[]
  privacy             ProfilePrivacy?
  reputation          ReputationMetrics?
  profileVersions     ProfileVersion[]
  connectedAccounts   ConnectedAccount[]
  behaviorEvents      BehaviorEvent[]
  candidateSkills     CandidateSkill[]
  resumeEmbeddings       ResumeEmbedding[]
  analytics              CandidateAnalytics?
  jobRecommendationScores JobRecommendationScore[]
  preferredRoles         PreferredRole[]
  jobAtsScores           JobAtsScore[]
  listingSkillGaps       JobListingSkillGap[]
  interviewSessions      InterviewSession[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([email])
  @@index([userId])
  @@index([skills], type: Gin)
  @@index([profileCompleteness])
}

model Experience {
  id             String    @id @default(cuid())
  candidateId    String
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  company        String
  jobTitle       String
  employmentType String?   // FULL_TIME, PART_TIME, CONTRACT, FREELANCE, INTERNSHIP
  location       String?
  startDate      DateTime
  endDate        DateTime?
  isCurrent      Boolean   @default(false)
  description    String?   @db.Text
  achievements   String[]  @default([])
  technologies   String[]  @default([])
  order          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([candidateId])
}

model Project {
  id           String    @id @default(cuid())
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  title        String
  description  String?   @db.Text
  technologies String[]  @default([])
  repoUrl      String?
  demoUrl      String?
  teamRole     String?
  startDate    DateTime?
  endDate      DateTime?
  isCurrent    Boolean   @default(false)
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([candidateId])
}

model Certification {
  id           String    @id @default(cuid())
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name         String
  issuer       String
  issueDate    DateTime?
  expiryDate   DateTime?
  credentialId String?
  credentialUrl String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([candidateId])
}

model ProfilePrivacy {
  id              String    @id @default(cuid())
  candidateId     String    @unique
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  isPublic        Boolean   @default(true)
  visibleToRecruiters Boolean @default(true)
  anonymousMode   Boolean   @default(false)
  hideContactInfo Boolean   @default(false)
  updatedAt       DateTime  @updatedAt
}

model ProfileVersion {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    Json      // Full profile JSON snapshot
  createdAt   DateTime  @default(now())

  @@index([candidateId])
}

model ReputationMetrics {
  id                     String    @id @default(cuid())
  candidateId            String    @unique
  candidate              Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewPerformance   Float     @default(0)
  recruiterFeedback      Float     @default(0)
  assessmentCompletionRate Float   @default(0)
  responseRate           Float     @default(0)
  overallScore           Float     @default(0)
  updatedAt              DateTime  @updatedAt
}

model Application {
  id                    String                     @id @default(cuid())
  job                   Job                        @relation(fields: [jobId], references: [id])
  jobId                 String
  candidate             Candidate                  @relation(fields: [candidateId], references: [id])
  candidateId           String
  status                ApplicationStatus          @default(APPLIED)
  aiScore               Float?
  aiNotes               String?                    @db.Text
  interviewProbability  Float?                     @default(0)
  applicationHealthScore Float?                    @default(0)
  readinessScore        Float?                     @default(0)
  interview             Interview?
  statusHistory         ApplicationStatusHistory[]
  recruiterActivities   RecruiterActivity[]
  assessments           Assessment[]
  notes                 ApplicationNote[]
  offer                 Offer?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@unique([jobId, candidateId])
  @@index([candidateId])
  @@index([jobId])
  @@index([status])
  @@index([createdAt])
  @@index([candidateId, status])
  @@index([candidateId, createdAt])
}

model ApplicationStatusHistory {
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        ApplicationStatus
  updatedBy     String?
  metadata      Json?
  createdAt     DateTime          @default(now())

  @@index([applicationId])
  @@index([applicationId, createdAt])
}

model RecruiterActivity {
  id            String                @id @default(cuid())
  applicationId String
  application   Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  activityType  RecruiterActivityType
  metadata      Json?
  createdAt     DateTime              @default(now())

  @@index([applicationId])
  @@index([applicationId, createdAt])
  @@index([activityType])
  @@index([createdAt])
}

model Assessment {
  id            String           @id @default(cuid())
  applicationId String
  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title         String
  type          String
  score         Float?
  maxScore      Float?
  deadline      DateTime?
  status        AssessmentStatus @default(PENDING)
  completedAt   DateTime?
  metadata      Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([applicationId])
  @@index([deadline])
  @@index([status])
}

model ApplicationNote {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  content       String      @db.Text
  authorId      String
  authorRole    String      @default("CANDIDATE")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId])
  @@index([applicationId, createdAt])
}

model Offer {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  salary        Int?
  currency      String?     @default("USD")
  benefits      String[]    @default([])
  startDate     DateTime?
  expiresAt     DateTime?
  status        OfferStatus @default(PENDING)
  metadata      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId])
}

model CandidateAnalytics {
  id                String    @id @default(cuid())
  candidateId       String    @unique
  candidate         Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applicationsSent  Int       @default(0)
  resumeViewed      Int       @default(0)
  shortlistedCount  Int       @default(0)
  interviewCount    Int       @default(0)
  offerCount        Int       @default(0)
  hiredCount        Int       @default(0)
  rejectedCount     Int       @default(0)
  withdrawnCount    Int       @default(0)
  avgHealthScore    Float     @default(0)
  avgResponseTime   Float?
  lastUpdatedAt     DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([candidateId])
}

model SavedJob {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([userId, jobId])
  @@index([userId, createdAt])
  @@index([jobId])
}

model JobAlert {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  location  String?
  createdAt DateTime  @default(now())
  jobId     String?
  job       Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([role])
  @@index([location])
}

model Education {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  school      String
  degree      String
  field       String
  startYear   String
  endYear     String?
  isCurrent   Boolean   @default(false)
  cgpa        String?
  description String?   @db.Text
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([candidateId])
}

model Skill {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name        String
  level       SkillLevel @default(INTERMEDIATE)
  category    String?    // e.g., "Frontend", "Backend", "DevOps", "Soft Skills"
  isSoftSkill Boolean    @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([candidateId])
}

model CandidateSkill {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name        String
  normalized  String
  level       Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([candidateId])
  @@index([normalized])
  @@unique([candidateId, normalized])
}

model JobSkill {
  id         String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name        String
  normalized  String
  importance  Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([jobId])
  @@index([normalized])
  @@unique([jobId, normalized])
}

enum BehaviorEventType {
  JOB_VIEW
  JOB_CLICK
  JOB_APPLICATION
  JOB_SAVE
  JOB_IGNORE
}

model BehaviorEvent {
  id         String            @id @default(cuid())
  candidateId String
  candidate  Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId      String?
  job        Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  eventType  BehaviorEventType
  metadata   Json?
  createdAt  DateTime          @default(now())

  @@index([candidateId, createdAt])
  @@index([candidateId, eventType])
  @@index([jobId, createdAt])
}

model ResumeEmbedding {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  source      String    @default("RESUME")
  dimensions  Int
  embedding   Float[]
  checksum    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([candidateId, createdAt])
}

model JobEmbedding {
  id         String   @id @default(cuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  source     String   @default("JOB_DESCRIPTION")
  dimensions Int
  embedding  Float[]
  checksum   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([jobId, source])
  @@index([jobId, createdAt])
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum AccountProvider {
  GITHUB
  LINKEDIN
  GOOGLE
  HUBSPOT
  SLACK
  ZOOM
  PORTFOLIO
  WEBSITE
  TWITTER
  KAGGLE
  LEETCODE
}

model ConnectedAccount {
  id             String          @id @default(cuid())
  candidateId    String
  candidate      Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  provider       AccountProvider
  username       String?         // display username / handle
  profileUrl     String          // validated external URL
  isOAuth        Boolean         @default(false)
  accessToken    String?         // encrypted at the application layer
  refreshToken   String?         // encrypted at the application layer
  tokenExpiresAt DateTime?       // when the access token expires
  scopes         String[]        @default([]) // granted OAuth scopes
  metadata       Json?           // provider-specific extra data
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([candidateId, provider])
  @@index([candidateId])
}

model Interview {
  id            String          @id @default(cuid())
  application   Application     @relation(fields: [applicationId], references: [id])
  applicationId String          @unique
  scheduledAt   DateTime
  duration      Int?            // duration in minutes
  meetingUrl    String?
  notes         String?         @db.Text
  type          InterviewType
  aiTranscript  String?         @db.Text
  aiFeedback    String?         @db.Text
  status        InterviewStatus @default(SCHEDULED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([scheduledAt])
  @@index([status])
}

enum Role {
  ADMIN
  RECRUITER
  CANDIDATE
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  REMOTE
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum JobStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  RESUME_VIEWED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  OFFER
  REJECTED
  HIRED
  WITHDRAWN
}

enum RecruiterActivityType {
  RESUME_VIEWED
  PROFILE_VIEWED
  SHORTLISTED
  INTERVIEW_SCHEDULED
  NOTE_ADDED
  ASSESSMENT_SENT
  OFFER_SENT
  REJECTED
}

enum AssessmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum InterviewType {
  AI_SCREENING
  VIDEO
  PHONE
  IN_PERSON
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum PreferredRoleSource {
  MANUAL
  INFERRED
  BEHAVIORAL
}

enum SalaryType {
  MONTHLY
  YEARLY
}

enum NotificationType {
  APPLICATION_STATUS_CHANGED
  INTERVIEW_SCHEDULED
  INTERVIEW_REMINDER
  OFFER_RECEIVED
  OFFER_ACCEPTED
  OFFER_DECLINED
  JOB_RECOMMENDATION
  PROFILE_VIEWED
  ASSESSMENT_ASSIGNED
  ASSESSMENT_DUE
  MESSAGE_RECEIVED
  SYSTEM
}

// ---- Candidate workspace models ----

model ResumeVersion {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  roleTarget  String?
  fileUrl     String?
  filePath    String?
  atsScore        Int?
  status          ResumeVersionStatus @default(DRAFT)
  pipelineStatus  PipelineStatus      @default(QUEUED)
  pipelineError   String?             @db.Text
  pipelineRawText String?             @db.Text
  piiMaskEncrypted String?            @db.Text
  tenantId        String?
  embeddedAt      DateTime?
  parsedContent   String?        @db.Text
  scoreBreakdown  String?        @db.Text
  improvements    String?        @db.Text
  suggestions     ResumeSuggestion[]
  parsedResume    ParsedResume?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ResumeSuggestion {
  id              String         @id @default(cuid())
  resumeVersionId String
  resumeVersion   ResumeVersion  @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)
  type            SuggestionType
  section         String
  title           String
  description     String         @db.Text
  applied         Boolean        @default(false)
  createdAt       DateTime       @default(now())
}

model MockInterviewSession {
  id         String                 @id @default(cuid())
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String?
  type       MockInterviewType      @default(TECHNICAL)
  status     MockInterviewStatus    @default(IN_PROGRESS)
  startedAt  DateTime               @default(now())
  endedAt    DateTime?
  transcript String?                @db.Text
  aiFeedback String?                @db.Text
  messages   MockInterviewMessage[]
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
}

model MockInterviewMessage {
  id        String               @id @default(cuid())
  sessionId String
  session   MockInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String               @db.Text
  createdAt DateTime             @default(now())
}

model CareerMilestone {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?   @db.Text
  targetDate  DateTime?
  completed   Boolean   @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SkillGoal {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     String?
  currentLevel Int      @default(0)
  targetLevel  Int      @default(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum ResumeVersionStatus {
  DRAFT
  ACTIVE
}

enum PipelineStatus {
  QUEUED
  PREPROCESSING
  PARSING
  PARSED
  EMBEDDING
  EMBEDDED
  SCORED
  COMPLETE
  FAILED
}

enum SuggestionType {
  CRITICAL
  IMPROVEMENT
  OPTIMIZATION
}

enum MockInterviewType {
  BEHAVIORAL
  TECHNICAL
  SYSTEM_DESIGN
}

enum MockInterviewStatus {
  IN_PROGRESS
  COMPLETED
}

enum MessageRole {
  USER
  ASSISTANT
}

// ---- Candidate Intelligence Pipeline Models ----

enum ProcessingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model CandidateProfile {
  id               String           @id @default(cuid())
  candidateId      String           @unique
  candidate        Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  version          Int              @default(1)
  readinessScore   Float            @default(0)
  processingStatus ProcessingStatus @default(PENDING)

  resumeRaw          ResumeRaw?
  resumeStructured   ResumeStructured?
  atsScore           ATSScore?
  skillGap           SkillGap?
  careerPath         CareerPath?
  reputationScore    ReputationScore?
  jobRecommendations JobRecommendation[]
  aiLogs             AIExplainabilityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ResumeRaw {
  id            String           @id @default(cuid())
  profileId     String           @unique
  profile       CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  fileUrl       String
  extractedText String           @db.Text
  uploadedAt    DateTime         @default(now())
}

model ResumeStructured {
  id         String           @id @default(cuid())
  profileId  String           @unique
  profile    CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skills     String[]
  experience Json
  education  Json
  updatedAt  DateTime         @updatedAt
}

model ATSScore {
  id              String           @id @default(cuid())
  profileId       String           @unique
  profile         CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  overallScore    Float
  roleBasedScores Json
  updatedAt       DateTime         @updatedAt
}

model SkillGap {
  id            String           @id @default(cuid())
  profileId     String           @unique
  profile       CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  missingSkills String[]
  learningPath  Json
  updatedAt     DateTime         @updatedAt
}

model CareerPath {
  id               String           @id @default(cuid())
  profileId        String           @unique
  profile          CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  suggestedRoles   String[]
  readinessPercent Float
  updatedAt        DateTime         @updatedAt
}

model JobRecommendation {
  id              String           @id @default(cuid())
  profileId       String
  profile         CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobId           String
  job             Job              @relation(fields: [jobId], references: [id])
  matchScore      Float
  skillMatch      Float?
  experienceMatch Float?
  locationMatch   Float?
  semanticScore   Float?
  readinessScore  Float?
  missingSkills   String[]
  reasons         String[]
  createdAt       DateTime         @default(now())

  @@unique([profileId, jobId])
  @@index([profileId, matchScore(sort: Desc)])
}

// Precomputed recommendation scores keyed by candidateId (not profileId).
// Updated asynchronously by recommendationWorker. Used by the fast API path.
model JobRecommendationScore {
  id                   String    @id @default(cuid())
  candidateId          String
  candidate            Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId                String
  job                  Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillMatchScore      Float     @default(0)
  experienceMatchScore Float     @default(0)
  locationMatchScore   Float     @default(0)
  behaviorScore        Float     @default(0)
  embeddingScore       Float     @default(0)
  totalScore           Float     @default(0)
  updatedAt            DateTime  @updatedAt

  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId])
  @@index([candidateId, totalScore(sort: Desc)])
}

model RoleTaxonomy {
  id             String              @id @default(cuid())
  roleName       String              @unique
  category       String
  skillsRequired Json?
  synonyms       String[]            @default([])
  preferredRoles PreferredRole[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([category])
  @@index([roleName])
  @@index([synonyms], type: Gin)
}

/// Ranked preferred roles stored on the candidate (intelligence layer + UI).
model PreferredRole {
  id              String              @id @default(cuid())
  candidateId     String
  candidate       Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  role            String
  priority        Int                 @default(5)
  confidenceScore Float               @default(0.5)
  source          PreferredRoleSource @default(MANUAL)
  roleTaxonomyId  String?
  roleTaxonomy    RoleTaxonomy?       @relation(fields: [roleTaxonomyId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([candidateId, role])
  @@index([candidateId])
  @@index([candidateId, priority])
  @@index([candidateId, confidenceScore(sort: Desc)])
}

model UserBehaviorSignal {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             String
  viewedJobs       Int      @default(0)
  appliedJobs      Int      @default(0)
  clickedRoles     Int      @default(0)
  timeSpentPerRole Int      @default(0) // total seconds
  searchQueries    Int      @default(0)
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, role])
  @@index([userId, updatedAt])
}

model UserSalaryProfile {
  id                 String     @id @default(cuid())
  userId             String     @unique
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  minSalary          Int
  maxSalary          Int
  currency           String     @default("INR")
  salaryType         SalaryType @default(YEARLY)
  isNegotiable       Boolean    @default(true)
  preferredLocations Json?
  confidenceScore    Float      @default(0.5)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([userId])
  @@index([currency, salaryType])
}

model JobSalaryData {
  id               String     @id @default(cuid())
  jobId            String     @unique
  job              Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  minOfferedSalary Int?
  maxOfferedSalary Int?
  currency         String     @default("INR")
  salaryType       SalaryType @default(YEARLY)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([jobId])
  @@index([currency, salaryType])
}

model SalaryInsights {
  id           String     @id @default(cuid())
  role         String
  location     String
  currency     String     @default("INR")
  salaryType   SalaryType @default(YEARLY)
  avgSalary    Int
  medianSalary Int
  percentile25 Int
  percentile75 Int
  source       String?    @default("INTERNAL_AGGREGATE")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([role])
  @@index([location])
  @@index([role, location, currency, salaryType])
  @@unique([role, location, currency, salaryType])
}

model ReputationScore {
  id        String           @id @default(cuid())
  profileId String           @unique
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  score     Int              @default(0)
  factors   Json
  updatedAt DateTime         @updatedAt
}

model AIExplainabilityLog {
  id              String           @id @default(cuid())
  profileId       String
  profile         CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  featureName     String
  inputHash       String?
  outputJson      Json
  executionTimeMs Int?
  createdAt       DateTime         @default(now())
}

// In-app notification hub — covers application events, interview reminders, offers, etc.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false)
  metadata  Json?            // e.g. { jobId, applicationId, interviewId }
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ---- InsForge-migrated tables (snake_case via @@map) ----

model JobListing {
  id               String               @id @default(cuid())
  title            String               @map("job_title")
  companyName      String               @map("company_name")
  location         String?
  jobType          String?              @map("job_type")
  experienceLevel  String?              @map("experience_level")
  salaryRange      String?              @map("salary_range")
  techStack        String[]             @default([]) @map("tech_stack")
  category         String?
  isFeatured       Boolean              @default(false) @map("is_featured")
  description      String?              @db.Text @map("job_description")
  requirements     String?              @db.Text
  responsibilities String?              @db.Text
  niceToHave       String?              @db.Text @map("nice_to_have")
  isActive         Boolean              @default(true) @map("is_active")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  atsScores        JobAtsScore[]
  skillGaps        JobListingSkillGap[]

  @@map("job_listings")
}

model JobAtsScore {
  id          String     @id @default(cuid())
  candidateId String
  listingId   String
  score       Float
  details     Json?
  createdAt   DateTime   @default(now())
  candidate   Candidate  @relation(fields: [candidateId], references: [id])
  listing     JobListing @relation(fields: [listingId], references: [id])

  @@unique([candidateId, listingId])
  @@map("job_ats_scores")
}

model JobListingSkillGap {
  id          String     @id @default(cuid())
  candidateId String
  listingId   String
  gaps        Json
  createdAt   DateTime   @default(now())
  candidate   Candidate  @relation(fields: [candidateId], references: [id])
  listing     JobListing @relation(fields: [listingId], references: [id])

  @@map("skill_gaps")
}

model SkillAlias {
  id        String   @id @default(cuid())
  alias     String   @unique
  canonical String
  source    String   @default("SEED")
  createdAt DateTime @default(now())

  @@map("skill_aliases")
}

enum RecruiterDecisionType {
  SHORTLISTED
  REJECTED
  HIRED
  PASSED_TO_INTERVIEW
}

enum DecisionSignalType {
  POSITIVE
  NEGATIVE
  NEUTRAL
}

enum JobSource {
  LISTING
  LEGACY_JOB
}

model RecruiterDecision {
  id                 String                @id @default(cuid())
  resumeId           String
  jobId              String
  jobSource          JobSource             @default(LEGACY_JOB)
  tenantId           String
  decision           RecruiterDecisionType
  decisionReason     String?               @db.Text
  atsScoreAtDecision Float?
  scoreBreakdown     Json?
  recruiterId        String
  signalType         DecisionSignalType
  signalStrength     Float
  roleType           String                @default("IC")
  decidedAt          DateTime              @default(now())

  @@index([tenantId, decidedAt])
  @@index([jobId])
  @@index([resumeId, jobId])
  @@map("recruiter_decisions")
}

model PromptVariant {
  variantId      String             @id @default(cuid())
  promptText     String             @db.Text
  active         Boolean            @default(true)
  trafficPercent Int                @default(50)
  metrics        Json?
  createdAt      DateTime           @default(now())
  assignments    PromptAssignment[]

  @@map("prompt_variants")
}

model PromptAssignment {
  id         String        @id @default(cuid())
  resumeId   String        @unique
  variantId  String
  variant    PromptVariant @relation(fields: [variantId], references: [variantId], onDelete: Cascade)
  assignedAt DateTime      @default(now())

  @@map("prompt_assignments")
}

model RecruiterCorrection {
  id             String   @id @default(cuid())
  resumeId       String
  field          String
  originalValue  String
  correctedValue String
  recruiterId    String
  createdAt      DateTime @default(now())

  @@index([field, originalValue, correctedValue])
  @@map("recruiter_corrections")
}

model TenantWeightProfile {
  id        String   @id @default(cuid())
  tenantId  String
  roleType  String
  weights   Json
  updatedAt DateTime @updatedAt

  @@unique([tenantId, roleType])
  @@map("tenant_weight_profiles")
}

model EmbeddingDriftRun {
  id               String   @id @default(cuid())
  driftScore       Float
  sampleSize       Int
  triggeredReindex Boolean  @default(false)
  details          Json?
  ranAt            DateTime @default(now())

  @@map("embedding_drift_runs")
}

model WeightRecalibrationRun {
  id              String   @id @default(cuid())
  tenantId        String
  roleType        String
  componentDeltas Json
  correlations    Json
  ranAt           DateTime @default(now())

  @@map("weight_recalibration_runs")
}

model InterviewSession {
  id          String                @id @default(cuid())
  candidateId String
  listingId   String?
  status      String                @default("active")
  createdAt   DateTime              @default(now())
  messages    InterviewMessage[]
  feedback    InterviewFeedback?
  evaluations InterviewEvaluation[]
  candidate   Candidate             @relation(fields: [candidateId], references: [id])

  @@map("interview_sessions")
}

model InterviewMessage {
  id        String           @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime         @default(now())
  session   InterviewSession @relation(fields: [sessionId], references: [id])

  @@map("interview_messages")
}

model InterviewFeedback {
  id        String           @id @default(cuid())
  sessionId String           @unique
  summary   String
  score     Float?
  createdAt DateTime         @default(now())
  session   InterviewSession @relation(fields: [sessionId], references: [id])

  @@map("interview_feedback")
}

model InterviewEvaluation {
  id         String           @id @default(cuid())
  sessionId  String
  questionId String?
  answer     String?
  score      Float?
  feedback   String?
  session    InterviewSession @relation(fields: [sessionId], references: [id])

  @@map("interview_evaluations")
}

model QuestionBank {
  id         String   @id @default(cuid())
  question   String
  category   String?
  difficulty String?
  tags       String[]

  @@map("question_bank")
}

model ParsedResume {
  id                String        @id @default(cuid())
  resumeVersionId   String        @unique
  parsedData        Json
  extractionSchema  Json?
  parseConfidence   Float?
  passesRun         Int[]         @default([])
  pass3Changed      Boolean       @default(false)
  createdAt         DateTime      @default(now())
  resumeVersion     ResumeVersion @relation(fields: [resumeVersionId], references: [id])

  @@map("parsed_resumes")
}

model ExtractionEvent {
  id         String   @id @default(cuid())
  resumeId   String
  tenantId   String?
  event      String
  passNumber Int?
  durationMs Int?
  confidence Float?
  fieldCount Int?
  error      String?  @db.Text
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([event, createdAt])
  @@index([resumeId])
  @@map("extraction_events")
}

model DailyMetric {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  metricKey  String
  value      Float
  domain     String?
  dimensions Json?
  createdAt  DateTime @default(now())

  @@unique([date, metricKey, domain])
  @@index([metricKey, date])
  @@map("daily_metrics")
}

model AlertCooldown {
  metricKey   String   @id
  lastFiredAt DateTime

  @@map("alert_cooldowns")
}
