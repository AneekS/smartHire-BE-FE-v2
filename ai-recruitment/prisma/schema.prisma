model Resume {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidateId      String
  candidate        Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  currentVersionId String?           @unique
  currentVersion   ResumeVersionV2?  @relation("CurrentResumeVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  isActive         Boolean           @default(true)
  versions         ResumeVersionV2[] @relation("ResumeVersions")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, candidateId])
  @@map("resumes")
}

model ResumeVersionV2 {
  id                    String                @id @default(cuid())
  resumeId              String
  resume                Resume                @relation("ResumeVersions", fields: [resumeId], references: [id], onDelete: Cascade)
  tenantId              String
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  blobUrl               String?
  blobPath              String?
  fileHash              String?
  textHash              String?
  mimeType              String?
  fileSizeBytes         Int?
  parsedResumeId        String?               @unique
  parsedResume          ParsedResume?         @relation("ParsedResumeV2Link", fields: [parsedResumeId], references: [id], onDelete: SetNull)
  searchEmbedding       ResumeSearchEmbedding?
  parseStatus           ParseStatus           @default(PENDING)
  parseConfidence       Float?
  requiresManualReview  Boolean               @default(false)
  versionNumber         Int                   @default(1)
  legacyResumeVersionId String?               @unique
  legacyResumeVersion   ResumeVersion?        @relation("LegacyResumeVersionBridge", fields: [legacyResumeVersionId], references: [id], onDelete: SetNull)
  currentForResume      Resume?               @relation("CurrentResumeVersion")
  applications          Application[]
  applicationAtsScores  ApplicationAtsScore[]
  extractionEvents      ExtractionEvent[]
  promptAssignments     ExtractionPromptAssignment[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([tenantId, createdAt])
  @@index([resumeId])
  @@map("resume_versions_v2")
}

model ResumeSearchEmbedding {
  id               String           @id @default(cuid())
  resumeVersionId  String           @unique
  resumeVersion    ResumeVersionV2  @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  searchIndexId    String?
  embeddingModel   String           @default("qwen3-embedding:8b")
  vectorDimensions Int              @default(4096)
  chunkCount       Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([tenantId, createdAt])
  @@map("resume_search_embeddings")
}

// =============================================================================
// TARGET Group 3: Application ATS scores (spec JobAtsScore)
// =============================================================================

model ApplicationAtsScore {
  id                   String            @id @default(cuid())
  tenantId             String
  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicationId        String            @unique
  application          Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  resumeVersionId      String
  resumeVersion        ResumeVersionV2   @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)
  jobId                String
  job                  Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  listingId            String?
  finalScore           Float
  semanticScore        Float
  skillScore           Float
  experienceScore      Float
  complianceScore      Float
  projectScore         Float
  educationScore       Float
  qualityScore         Float
  confidence           Float
  requiresManualReview Boolean           @default(false)
  scoreHash            String?
  industryProfile      IndustryProfile   @default(GENERAL)
  seniorityBand        SeniorityBand?
  scoreVersion         String            @default("v3")
  computedAt           DateTime          @default(now())
  skillGaps            AtsSkillGap[]
  careerReadiness      CareerReadiness?
  recruiterOutcomes    RecruiterOutcomeSignal[]
  createdAt            DateTime          @default(now())

  @@index([tenantId, computedAt])
  @@index([jobId])
  @@index([resumeVersionId])
  @@map("application_ats_scores")
}

model AtsSkillGap {
  id             String              @id @default(cuid())
  jobAtsScoreId  String
  jobAtsScore    ApplicationAtsScore @relation(fields: [jobAtsScoreId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  missingSkill   String
  importance     Float               @default(1)
  canonicalSkill String?
  createdAt      DateTime            @default(now())

  @@index([jobAtsScoreId])
  @@index([tenantId, createdAt])
  @@map("ats_skill_gaps")
}

model CareerReadiness {
  id               String              @id @default(cuid())
  jobAtsScoreId    String              @unique
  jobAtsScore      ApplicationAtsScore @relation(fields: [jobAtsScoreId], references: [id], onDelete: Cascade)
  tenantId         String
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  overallReadiness Float
  strengthAreas    Json                @default("[]")
  developmentAreas Json                @default("[]")
  timeToReady      String?
  createdAt        DateTime            @default(now())

  @@index([tenantId, createdAt])
  @@map("career_readiness")
}

// =============================================================================
// TARGET Group 4: Interviews (v2)
// =============================================================================

model MockInterviewSessionV2 {
  id              String     @id @default(cuid())
  candidateId     String
  candidate       Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobId           String?
  job             Job?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  model           String     @default("gpt-4o-mini")
  sessionType     String
  status          String     @default("active")
  transcript      Json?
  feedbackReport  Json?
  durationSeconds Int?
  startedAt       DateTime   @default(now())
  completedAt     DateTime?
  createdAt       DateTime   @default(now())

  @@index([tenantId, createdAt])
  @@index([candidateId])
  @@map("mock_interview_sessions_v2")
}

// =============================================================================
// TARGET Group 5: Feedback loop
// =============================================================================

model RecruiterOutcomeSignal {
  id                     String              @id @default(cuid())
  tenantId               String
  tenant                 Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recruiterId            String
  recruiter              Recruiter           @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  applicationAtsScoreId  String
  applicationAtsScore    ApplicationAtsScore @relation(fields: [applicationAtsScoreId], references: [id], onDelete: Cascade)
  candidateId            String
  candidate              Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId                  String
  job                    Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  outcome                RecruiterOutcome
  outcomeDate            DateTime            @default(now())
  atsFinalScoreAtOutcome Float?
  noteText               String?             @db.Text
  createdAt              DateTime            @default(now())

  @@index([tenantId, outcomeDate])
  @@index([applicationAtsScoreId])
  @@map("recruiter_outcome_signals")
}

model WeightCalibration {
  id                  String          @id @default(cuid())
  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  industryProfile     IndustryProfile
  semanticWeight      Float
  skillWeight         Float
  experienceWeight    Float
  complianceWeight    Float
  projectWeight       Float
  educationWeight     Float
  qualityWeight       Float
  sampleSize          Int             @default(0)
  discriminationPower Float?
  calibrationVersion  Int             @default(1)
  isActive            Boolean         @default(true)
  calibratedAt        DateTime        @default(now())
  createdAt           DateTime        @default(now())

  @@index([tenantId, industryProfile])
  @@index([tenantId, createdAt])
  @@map("weight_calibrations")
}

// =============================================================================
// TARGET Group 6: Prompt A/B testing (extraction)
// =============================================================================

model ExtractionPromptVariant {
  id                 String                      @id @default(cuid())
  tenantId           String
  tenant             Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phase              Int
  variantName        String
  systemPrompt       String                      @db.Text
  userPromptTemplate String                      @db.Text
  isActive           Boolean                     @default(true)
  isControl          Boolean                     @default(false)
  assignments        ExtractionPromptAssignment[]
  extractionEvents   ExtractionEvent[]
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@index([tenantId, phase])
  @@index([tenantId, createdAt])
  @@map("extraction_prompt_variants")
}

model ExtractionPromptAssignment {
  id                String                  @id @default(cuid())
  tenantId          String
  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resumeVersionId   String
  resumeVersion     ResumeVersionV2         @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)
  promptVariantId   String
  promptVariant     ExtractionPromptVariant @relation(fields: [promptVariantId], references: [id], onDelete: Cascade)
  extractionEventId String?
  assignedAt        DateTime                @default(now())

  @@unique([resumeVersionId, promptVariantId])
  @@index([tenantId, assignedAt])
  @@map("extraction_prompt_assignments")
}

// =============================================================================
// TARGET Group 7: Observability — audit log
// =============================================================================

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  action     String
  entityId   String?
  entityType String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?  @db.Text
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([tenantId, occurredAt])
  @@index([userId, occurredAt])
  @@map("audit_logs")
}
