generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String                  @id @default(cuid())
  name                   String?
  email                  String                  @unique
  emailVerified          DateTime?
  password               String?
  image                  String?
  role                   Role                    @default(CANDIDATE)
  companyId              String?
  headline               String?
  phone                  String?
  location               String?
  school                 String?
  graduationYear         String?
  linkedInUrl            String?
  githubUrl              String?
  websiteUrl             String?
  jobAlerts              Boolean                 @default(true)
  aiSuggestions          Boolean                 @default(false)
  publicProfile          Boolean                 @default(true)
  reputationScore        Int                     @default(0)
  technicalScore         Int                     @default(0)
  softScore              Int                     @default(0)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  accounts               Account[]
  candidate              Candidate?
  careerMilestones       CareerMilestone[]
  jobs                   Job[]
  jobAlertRules          JobAlert[]
  mockSessions           MockInterviewSession[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  userPreference         UserPreference?
  roleFitScores          RoleFitScore[]
  recruiter              Recruiter?
  resumeVersions         ResumeVersion[]
  savedJobsList          SavedJob[]
  sessions               Session[]
  skillGoals             SkillGoal[]
  company                Company?                @relation(fields: [companyId], references: [id])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id             String   @id @default(cuid())
  name           String
  logo           String?
  industry       String?
  size           String?
  averageSalaryL Int?
  employeeRating Float?
  website        String?
  description    String?
  location       String?
  foundedYear    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  jobs           Job[]
  users          User[]

  @@index([name])
  @@index([industry])
}

model Recruiter {
  id         String   @id @default(cuid())
  userId     String   @unique
  name       String
  title      String?
  department String?
  bio        String?
  avatarUrl  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  jobs       Job[]
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Job {
  id                   String                   @id @default(cuid())
  title                String
  description          String
  requirements         String
  location             String
  type                 JobType
  status               JobStatus                @default(ACTIVE)
  salary               String?
  salaryMin            Int?
  salaryMax            Int?
  experienceLevel      String?
  experienceMin        Int?
  experienceMax        Int?
  workMode             WorkMode?
  requiredSkills       String[]                 @default([])
  userId               String
  companyId            String
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  recruiterId          String?
  applications         Application[]
  behaviorEvents       BehaviorEvent[]
  company              Company                  @relation(fields: [companyId], references: [id])
  recruiter            Recruiter?               @relation(fields: [recruiterId], references: [id])
  postedBy             User                     @relation(fields: [userId], references: [id])
  alerts               JobAlert[]
  embeddings           JobEmbedding[]
  jobRecommendations   JobRecommendation[]
  recommendationScores JobRecommendationScore[]
  jobSkills            JobSkill[]
  savedBy              SavedJob[]

  @@index([title])
  @@index([location])
  @@index([experienceLevel])
  @@index([experienceMin, experienceMax])
  @@index([createdAt])
  @@index([workMode])
  @@index([type])
  @@index([status, createdAt])
  @@index([companyId])
  @@index([salaryMin])
  @@index([salaryMax])
  @@index([requiredSkills], type: Gin)
  @@index([recruiterId])
}

model Candidate {
  id                      String                   @id @default(cuid())
  userId                  String?                  @unique
  name                    String
  email                   String                   @unique
  phone                   String?
  headline                String?
  location                String?
  city                    String?
  country                 String?
  photoUrl                String?
  avatarUrl               String?
  summary                 String?
  profileCompleteness     Int                      @default(0)
  resumeUrl               String?
  skills                  String[]                 @default([])
  experience              Int?
  aiScore                 Float?
  aiSummary               String?
  availability            String?
  workAuthorization       String?
  openToFreelance         Boolean                  @default(false)
  internshipInterest      Boolean                  @default(false)
  languagesSpoken         String[]                 @default([])
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  aiInsights              AIProfileInsights?
  applications            Application[]
  behaviorEvents          BehaviorEvent[]
  user                    User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  analytics               CandidateAnalytics?
  profile                 CandidateProfile?
  candidateSkills         CandidateSkill[]
  careerPreference        CareerPreference?
  certifications          Certification[]
  connectedAccounts       ConnectedAccount[]
  educations              Education[]
  experiences             Experience[]
  jobRecommendationScores JobRecommendationScore[]
  privacy                 ProfilePrivacy?
  profileVersions         ProfileVersion[]
  projects                Project[]
  reputation              ReputationMetrics?
  resumeEmbeddings        ResumeEmbedding[]
  skillRecords            Skill[]

  @@index([email])
  @@index([userId])
  @@index([skills], type: Gin)
  @@index([profileCompleteness])
}

model Experience {
  id             String    @id @default(cuid())
  candidateId    String
  company        String
  jobTitle       String
  employmentType String?
  location       String?
  startDate      DateTime
  endDate        DateTime?
  isCurrent      Boolean   @default(false)
  description    String?
  achievements   String[]  @default([])
  technologies   String[]  @default([])
  order          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model Project {
  id           String    @id @default(cuid())
  candidateId  String
  title        String
  description  String?
  technologies String[]  @default([])
  repoUrl      String?
  demoUrl      String?
  teamRole     String?
  startDate    DateTime?
  endDate      DateTime?
  isCurrent    Boolean   @default(false)
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model Certification {
  id            String    @id @default(cuid())
  candidateId   String
  name          String
  issuer        String
  issueDate     DateTime?
  expiryDate    DateTime?
  credentialId  String?
  credentialUrl String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model CareerPreference {
  id                  String    @id @default(cuid())
  candidateId         String    @unique
  preferredRoles      String[]  @default([])
  preferredIndustries String[]  @default([])
  preferredLocations  String[]  @default([])
  workMode            String?
  salaryMin           Int?
  salaryMax           Int?
  currency            String?   @default("USD")
  openToRelocation    Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  candidate           Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model ProfilePrivacy {
  id                  String    @id @default(cuid())
  candidateId         String    @unique
  isPublic            Boolean   @default(true)
  visibleToRecruiters Boolean   @default(true)
  anonymousMode       Boolean   @default(false)
  hideContactInfo     Boolean   @default(false)
  updatedAt           DateTime  @updatedAt
  candidate           Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model ProfileVersion {
  id          String    @id @default(cuid())
  candidateId String
  version     Int
  snapshot    Json
  createdAt   DateTime  @default(now())
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model AIProfileInsights {
  id                        String    @id @default(cuid())
  candidateId               String    @unique
  extractedSkills           String[]  @default([])
  experienceSummary         String?
  careerLevel               String?
  roleReadinessScore        Float?
  skillStrengthDistribution Json?
  suggestedImprovements     String[]  @default([])
  lastAnalyzedAt            DateTime?
  updatedAt                 DateTime  @updatedAt
  candidate                 Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model ReputationMetrics {
  id                       String    @id @default(cuid())
  candidateId              String    @unique
  interviewPerformance     Float     @default(0)
  recruiterFeedback        Float     @default(0)
  assessmentCompletionRate Float     @default(0)
  responseRate             Float     @default(0)
  overallScore             Float     @default(0)
  updatedAt                DateTime  @updatedAt
  candidate                Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model Application {
  id                     String                     @id @default(cuid())
  jobId                  String
  candidateId            String
  status                 ApplicationStatus          @default(APPLIED)
  aiScore                Float?
  aiNotes                String?
  interviewProbability   Float?                     @default(0)
  applicationHealthScore Float?                     @default(0)
  readinessScore         Float?                     @default(0)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  candidate              Candidate                  @relation(fields: [candidateId], references: [id])
  job                    Job                        @relation(fields: [jobId], references: [id])
  notes                  ApplicationNote[]
  statusHistory          ApplicationStatusHistory[]
  assessments            Assessment[]
  interview              Interview?
  offer                  Offer?
  recruiterActivities    RecruiterActivity[]

  @@unique([jobId, candidateId])
  @@index([candidateId])
  @@index([jobId])
  @@index([status])
  @@index([createdAt])
  @@index([candidateId, status])
  @@index([candidateId, createdAt])
}

model ApplicationStatusHistory {
  id            String            @id @default(cuid())
  applicationId String
  status        ApplicationStatus
  updatedBy     String?
  metadata      Json?
  createdAt     DateTime          @default(now())
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([applicationId, createdAt])
}

model RecruiterActivity {
  id            String                @id @default(cuid())
  applicationId String
  activityType  RecruiterActivityType
  metadata      Json?
  createdAt     DateTime              @default(now())
  application   Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([applicationId, createdAt])
  @@index([activityType])
  @@index([createdAt])
}

model Assessment {
  id            String           @id @default(cuid())
  applicationId String
  title         String
  type          String
  score         Float?
  maxScore      Float?
  deadline      DateTime?
  status        AssessmentStatus @default(PENDING)
  completedAt   DateTime?
  metadata      Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([deadline])
  @@index([status])
}

model ApplicationNote {
  id            String      @id @default(cuid())
  applicationId String
  content       String
  authorId      String
  authorRole    String      @default("CANDIDATE")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([applicationId, createdAt])
}

model Offer {
  id            String      @id @default(cuid())
  applicationId String      @unique
  salary        Int?
  currency      String?     @default("USD")
  benefits      String[]    @default([])
  startDate     DateTime?
  expiresAt     DateTime?
  metadata      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  status        OfferStatus @default(PENDING)
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model CandidateAnalytics {
  id               String    @id @default(cuid())
  candidateId      String    @unique
  applicationsSent Int       @default(0)
  resumeViewed     Int       @default(0)
  shortlistedCount Int       @default(0)
  interviewCount   Int       @default(0)
  offerCount       Int       @default(0)
  hiredCount       Int       @default(0)
  rejectedCount    Int       @default(0)
  withdrawnCount   Int       @default(0)
  avgHealthScore   Float     @default(0)
  avgResponseTime  Float?
  lastUpdatedAt    DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  candidate        Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, createdAt])
  @@index([jobId])
}

model JobAlert {
  id        String   @id @default(cuid())
  userId    String
  role      String
  location  String?
  createdAt DateTime @default(now())
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([role])
  @@index([location])
}

model Education {
  id          String    @id @default(cuid())
  candidateId String
  school      String
  degree      String
  field       String
  startYear   String
  endYear     String?
  isCurrent   Boolean   @default(false)
  cgpa        String?
  description String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model Skill {
  id          String     @id @default(cuid())
  candidateId String
  name        String
  level       SkillLevel @default(INTERMEDIATE)
  category    String?
  isSoftSkill Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  candidate   Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model CandidateSkill {
  id          String    @id @default(cuid())
  candidateId String
  name        String
  normalized  String
  level       Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, normalized])
  @@index([candidateId])
  @@index([normalized])
}

model JobSkill {
  id         String   @id @default(cuid())
  jobId      String
  name       String
  normalized String
  importance Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, normalized])
  @@index([jobId])
  @@index([normalized])
}

model BehaviorEvent {
  id          String            @id @default(cuid())
  candidateId String
  jobId       String?
  eventType   BehaviorEventType
  metadata    Json?
  createdAt   DateTime          @default(now())
  candidate   Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job         Job?              @relation(fields: [jobId], references: [id])

  @@index([candidateId, createdAt])
  @@index([candidateId, eventType])
  @@index([jobId, createdAt])
}

model ResumeEmbedding {
  id          String    @id @default(cuid())
  candidateId String
  source      String    @default("RESUME")
  dimensions  Int
  embedding   Float[]
  checksum    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt])
}

model JobEmbedding {
  id         String   @id @default(cuid())
  jobId      String
  source     String   @default("JOB_DESCRIPTION")
  dimensions Int
  embedding  Float[]
  checksum   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, source])
  @@index([jobId, createdAt])
}

model ConnectedAccount {
  id             String          @id @default(cuid())
  candidateId    String
  provider       AccountProvider
  username       String?
  profileUrl     String
  isOAuth        Boolean         @default(false)
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  scopes         String[]        @default([])
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  candidate      Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, provider])
  @@index([candidateId])
}

model Interview {
  id            String          @id @default(cuid())
  applicationId String          @unique
  scheduledAt   DateTime
  type          InterviewType
  aiTranscript  String?
  aiFeedback    String?
  status        InterviewStatus @default(SCHEDULED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  duration      Int?
  meetingUrl    String?
  notes         String?
  application   Application     @relation(fields: [applicationId], references: [id])

  @@index([scheduledAt])
  @@index([status])
}

model ResumeVersion {
  id             String              @id @default(cuid())
  userId         String
  title          String
  roleTarget     String?
  fileUrl        String?
  atsScore       Int?
  status         ResumeVersionStatus @default(DRAFT)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  improvements   String?
  parsedContent  String?
  scoreBreakdown String?
  suggestions    ResumeSuggestion[]
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ResumeSuggestion {
  id              String         @id @default(cuid())
  resumeVersionId String
  type            SuggestionType
  section         String
  title           String
  description     String
  applied         Boolean        @default(false)
  createdAt       DateTime       @default(now())
  resumeVersion   ResumeVersion  @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)
}

model MockInterviewSession {
  id         String                 @id @default(cuid())
  userId     String
  title      String?
  type       MockInterviewType      @default(TECHNICAL)
  status     MockInterviewStatus    @default(IN_PROGRESS)
  startedAt  DateTime               @default(now())
  endedAt    DateTime?
  transcript String?
  aiFeedback String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  messages   MockInterviewMessage[]
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MockInterviewMessage {
  id        String               @id @default(cuid())
  sessionId String
  role      MessageRole
  content   String
  createdAt DateTime             @default(now())
  session   MockInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model CareerMilestone {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  targetDate  DateTime?
  completed   Boolean   @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SkillGoal {
  id           String   @id @default(cuid())
  userId       String
  name         String
  category     String?
  currentLevel Int      @default(0)
  targetLevel  Int      @default(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CandidateProfile {
  id                 String                @id @default(cuid())
  candidateId        String                @unique
  version            Int                   @default(1)
  readinessScore     Float                 @default(0)
  processingStatus   ProcessingStatus      @default(PENDING)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  aiLogs             AIExplainabilityLog[]
  atsScore           ATSScore?
  candidate          Candidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  careerPath         CareerPath?
  jobRecommendations JobRecommendation[]
  reputationScore    ReputationScore?
  resumeRaw          ResumeRaw?
  resumeStructured   ResumeStructured?
  skillGap           SkillGap?
}

model ResumeRaw {
  id            String           @id @default(cuid())
  profileId     String           @unique
  fileUrl       String
  extractedText String
  uploadedAt    DateTime         @default(now())
  profile       CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ResumeStructured {
  id         String           @id @default(cuid())
  profileId  String           @unique
  skills     String[]
  experience Json
  education  Json
  updatedAt  DateTime         @updatedAt
  profile    CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ATSScore {
  id              String           @id @default(cuid())
  profileId       String           @unique
  overallScore    Float
  roleBasedScores Json
  updatedAt       DateTime         @updatedAt
  profile         CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model SkillGap {
  id            String           @id @default(cuid())
  profileId     String           @unique
  missingSkills String[]
  learningPath  Json
  updatedAt     DateTime         @updatedAt
  profile       CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model CareerPath {
  id               String           @id @default(cuid())
  profileId        String           @unique
  suggestedRoles   String[]
  readinessPercent Float
  updatedAt        DateTime         @updatedAt
  profile          CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model JobRecommendation {
  id              String           @id @default(cuid())
  profileId       String
  jobId           String
  matchScore      Float
  reasons         String[]
  createdAt       DateTime         @default(now())
  skillMatch      Float?
  experienceMatch Float?
  locationMatch   Float?
  semanticScore   Float?
  readinessScore  Float?
  missingSkills   String[]
  job             Job              @relation(fields: [jobId], references: [id])
  profile         CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, jobId])
  @@index([profileId, matchScore(sort: Desc)])
}

model JobRecommendationScore {
  id                   String    @id @default(cuid())
  candidateId          String
  jobId                String
  skillMatchScore      Float     @default(0)
  experienceMatchScore Float     @default(0)
  locationMatchScore   Float     @default(0)
  behaviorScore        Float     @default(0)
  embeddingScore       Float     @default(0)
  totalScore           Float     @default(0)
  updatedAt            DateTime  @updatedAt
  candidate            Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job                  Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId])
  @@index([candidateId, totalScore(sort: Desc)])
}

model ReputationScore {
  id        String           @id @default(cuid())
  profileId String           @unique
  score     Int              @default(0)
  factors   Json
  updatedAt DateTime         @updatedAt
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model AIExplainabilityLog {
  id              String           @id @default(cuid())
  profileId       String
  featureName     String
  inputHash       String?
  outputJson      Json
  executionTimeMs Int?
  createdAt       DateTime         @default(now())
  profile         CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Notification {
  id              String                    @id @default(cuid())
  userId          String
  type            NotificationType
  title           String
  message         String
  isRead          Boolean                   @default(false)
  metadata        Json?
  createdAt       DateTime                  @default(now())
  category        NotificationCategory      @default(SYSTEM)
  deliveryChannel NotificationChannel       @default(IN_APP)
  priority        NotificationPriority      @default(MEDIUM)
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryLogs    NotificationDeliveryLog[]

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([userId, category])
  @@index([userId, priority])
}

model NotificationPreference {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  inAppEnabled            Boolean  @default(true)
  emailEnabled            Boolean  @default(true)
  jobAlerts               Boolean  @default(true)
  interviewAlerts         Boolean  @default(true)
  careerAlerts            Boolean  @default(true)
  recruiterActivityAlerts Boolean  @default(true)
  communityAlerts         Boolean  @default(true)
  applicationAlerts       Boolean  @default(true)
  reminderAlerts          Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationDeliveryLog {
  id             String              @id @default(cuid())
  notificationId String
  channel        NotificationChannel
  status         DeliveryStatus      @default(PENDING)
  sentAt         DateTime?
  failureReason  String?
  createdAt      DateTime            @default(now())
  notification   Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([status])
}

model UserPreference {
  id                  String           @id @default(uuid())
  userId              String           @unique
  primaryRole         String
  secondaryRoles      String[]
  exploratoryRoles    String[]
  experienceLevel     ExperienceLevel
  preferredIndustries String[]
  preferredWorkTypes  WorkType[]
  preferredLocations  String[]
  salaryMin           Int
  salaryTarget        Int
  salaryMax           Int
  salaryVisibility    SalaryVisibility @default(RANGE_ONLY)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([experienceLevel])
  @@index([primaryRole])
}

model RoleFitScore {
  id        String   @id @default(uuid())
  userId    String
  role      String
  score     Float
  strengths String[]
  skillGaps String[]
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([role])
  @@index([userId, role])
  @@index([userId, score(sort: Desc)])
}

model SalaryInsight {
  id           String          @id @default(uuid())
  role         String
  location     String
  experience   ExperienceLevel
  salaryMin    Int
  salaryMedian Int
  salaryMax    Int
  createdAt    DateTime        @default(now())

  @@index([role])
  @@index([location])
  @@index([experience])
  @@index([role, location, experience])
}

