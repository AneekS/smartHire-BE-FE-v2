# Azure PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

PGHOST=your-db.postgres.database.azure.com
PGUSER=your_user
PGPORT=5432
PGDATABASE=postgres
PGPASSWORD=your_password

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=ACCOUNT;AccountKey=KEY;EndpointSuffix=core.windows.net
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account
AZURE_STORAGE_ACCOUNT_KEY=your_storage_key
AZURE_STORAGE_CONTAINER_RESUMES=resumes
AZURE_STORAGE_CONTAINER_AVATARS=avatars

# Azure Redis (TLS)
REDIS_URL=rediss://default:YOUR_KEY@your-redis.redis.azure.net:10000

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_ADMIN_KEY=your_search_admin_key
AZURE_SEARCH_INDEX=resumes-index

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# PII at-rest encryption (32+ char secret; required to persist piiMaskEncrypted)
PII_ENCRYPTION_KEY=change-me-to-a-long-random-secret

# Parsing tuning (qwen3:8b stack)
CONFIDENCE_THRESHOLD=0.70
OLLAMA_EXTRACTION_TIMEOUT_MS=600000
OLLAMA_EXTRACTION_MAX_CHARS=12000
OLLAMA_EXTRACTION_NUM_PREDICT=4096
OLLAMA_EXTRACTION_MAX_PASSES=3
EXTRACTION_FAST_MODE=false
SKIP_RESUME_IMPROVEMENTS_LLM=true
SKIP_INLINE_EMBED=true
# Async upload: true in production by default; set false for local sync parse
ASYNC_RESUME_PIPELINE=false
RESUME_WORKER_CONCURRENCY=1
MAX_PARALLEL_WORKERS=50
CACHE_TTL_FILE=31536000
CACHE_TTL_EXTRACTION=86400

# Ollama — extraction + chat (3-pass parse, improvements, JD parse, explainer)
OLLAMA_EXTRACTION_MODEL=qwen3:8b
OLLAMA_POOL=http://localhost:11434
OLLAMA_EMBED_POOL=http://localhost:11434
OLLAMA_MIN_HEALTHY_NODES=1

# Ollama — embeddings (do NOT use qwen3:8b here)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:8b
OLLAMA_KEEP_ALIVE=10m

# Preprocessor / OCR
ENABLE_OCR=true
TESSERACT_LANG=eng
BLOB_SAS_EXPIRY_DAYS=7

# Pipeline flags
USE_OLLAMA_EMBEDDINGS=true
# Must match Ollama embed model output dims (qwen3-embedding:8b → 4096)
EMBED_VECTOR_DIMENSIONS=4096

# Scale pipeline — Event Grid + priority embed queues
AZURE_EVENTGRID_TOPIC_ENDPOINT=
AZURE_EVENTGRID_TOPIC_KEY=
PREMIUM_TENANT_IDS=
EMBED_WORKER_CONCURRENCY=1

# AI
OPENAI_API_KEY=
SCORING_FALLBACK_LLM=false

# OAuth integrations (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Ops alerts
OPS_ALERT_EMAIL=
OPS_ALERT_FROM=SmartHire Ops <ops@smarthire.ai>
OPS_SLACK_WEBHOOK_URL=
RESEND_API_KEY=

# Observability
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
APPLICATIONINSIGHTS_CONNECTION_STRING=
INTERNAL_DASHBOARD_SECRET=
RATE_LIMIT_UPLOAD_PER_HOUR=100
RATE_LIMIT_SCORE_PER_HOUR=1000
LOG_LEVEL=info
