{
  "name": "ai-recruitment",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:migrate:deploy && npx prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "test:accuracy": "EXTRACTION_FAST_MODE=true OLLAMA_EXTRACTION_MAX_PASSES=1 vitest run src/parsing/extractor.accuracy.test.ts",
    "test:accuracy:live": "vitest run src/parsing/extractor.accuracy.test.ts -t \"live Ollama\"",
    "fixtures:generate": "node scripts/generate-resume-fixtures.mjs",
    "worker:embeddings": "tsx --import ./scripts/load-env.mjs src/workers/embedding.worker.ts",
    "worker:app-tracker": "tsx --import ./scripts/load-env.mjs src/workers/application-tracker.worker.ts",
    "worker:recommendations": "tsx --import ./scripts/load-env.mjs src/workers/recommendationWorker.ts",
    "worker:analytics": "tsx --import ./scripts/load-env.mjs src/workers/analyticsWorker.ts",
    "worker:cache": "tsx --import ./scripts/load-env.mjs src/workers/cacheWorker.ts",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:validate": "prisma validate",
    "db:sync": "prisma generate && prisma db push",
    "db:ping": "node scripts/db-ping.mjs",
    "storage:ping": "node scripts/azure-storage-ping.mjs",
    "ollama:ping": "node scripts/ollama-ping.mjs",
    "local:resume-check": "node scripts/local-ollama-resume-check.mjs",
    "cache:clear-extraction": "node scripts/clear-extraction-cache.mjs",
    "search:ping": "node scripts/azure-search-ping.mjs",
    "search:setup": "node scripts/setup-azure-search-index.mjs",
    "worker:resume-index": "tsx --import ./scripts/load-env.mjs src/workers/resume-index.worker.ts",
    "worker:parse": "tsx --import ./scripts/load-env.mjs src/workers/parse-resume.worker.ts",
    "worker:embed": "tsx --import ./scripts/load-env.mjs src/workers/embed-chunks.worker.ts",
    "db:seed:jobs": "node scripts/seed-job-listings.mjs",
    "db:seed:skill-aliases": "node scripts/seed-skill-aliases.mjs",
    "db:seed:prompt-variants": "node scripts/seed-prompt-variants.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.37",
    "@auth/prisma-adapter": "^2.11.1",
    "@azure/eventgrid": "^5.12.0",
    "@azure/storage-blob": "^12.31.0",
    "@clerk/nextjs": "^7.3.7",
    "@clerk/ui": "^1.13.0",
    "@hookform/resolvers": "^5.2.2",
    "@napi-rs/canvas": "^1.0.0",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@react-pdf/renderer": "^4.3.2",
    "@sentry/nextjs": "^10.55.0",
    "@uploadthing/react": "^7.3.3",
    "ai": "^6.0.105",
    "applicationinsights": "^3.15.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.71.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "diff": "^8.0.3",
    "framer-motion": "^12.34.3",
    "ioredis": "^5.10.0",
    "lucide-react": "^0.575.0",
    "mammoth": "^1.11.0",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.6",
    "openai": "^6.25.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.4.2",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "recharts": "^3.8.0",
    "redis": "^5.11.0",
    "resend": "^6.9.3",
    "sonner": "^2.0.7",
    "svix": "^1.94.0",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "tesseract.js": "^7.0.0",
    "uploadthing": "^7.7.4",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/diff": "^7.0.2",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^7.1.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
